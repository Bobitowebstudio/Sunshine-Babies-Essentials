# ==============================================================================
# SUNSHINE BABIES ESSENTIALS - ENVIRONMENT VARIABLES EXAMPLE (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to '.env' (or '.env.local') in the project root.
# 2. Replace all placeholder values with your actual configuration credentials.
# 3. NEVER commit your actual '.env' or secret keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE & AUTHENTICATION (Required for Database Persistence)
# ------------------------------------------------------------------------------
# VITE_SUPABASE_URL: Your Supabase Project URL.
# IMPORTANT: Use the base project URL (e.g. https://YOUR_PROJECT_ID.supabase.co).
# Do NOT append '/rest/v1/' or any endpoint paths.
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"

# VITE_SUPABASE_PUBLISHABLE_KEY (or VITE_SUPABASE_ANON_KEY):
# The public/anon key from your Supabase Project Settings -> API.
# This key is safe to expose in client-side code with Row Level Security (RLS) enabled.
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_ANON_KEY=""

# SUPABASE_SERVICE_ROLE_KEY: (Optional, Backend Server Only)
# Super-admin service role key. Keep this private and NEVER expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# ------------------------------------------------------------------------------
# 2. PAYSTACK PAYMENT GATEWAY (Optional / When Ready for Live Payments)
# ------------------------------------------------------------------------------
# VITE_PAYSTACK_PUBLIC_KEY: Public key for client-side checkout popup (pk_test_... or pk_live_...)
VITE_PAYSTACK_PUBLIC_KEY=""

# PAYSTACK_SECRET_KEY: Secret key used by the backend server to verify transactions (sk_test_... or sk_live_...)
PAYSTACK_SECRET_KEY=""

# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI AI (Server-Side Only)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Used for server-side AI catalog and content features.
# NEVER commit real keys. In AI Studio, this is managed via the Settings/Secrets panel.
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 4. APPLICATION & HOSTING CONFIGURATION
# ------------------------------------------------------------------------------
# APP_URL: The base URL where the application is hosted (e.g. http://localhost:3000)
APP_URL="http://localhost:3000"
